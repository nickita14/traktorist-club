# Server settings for compose.prod.yaml. On the server: cp .env.prod.example .env, chmod 600 .env,
# then replace every value (docs/deploy.md shows how to generate the secrets). Never commit .env.
# ENVIRONMENT is not set here: compose.prod.yaml sets it to production itself.

# --- Site ---
SITE_DOMAIN=club.example.com
# 50+ random characters: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=replace-with-a-long-random-value
# Admin prefix, hard to guess, not "admin/": python3 -c 'import secrets; print(secrets.token_hex(6))'
ADMIN_URL=replace-me/
# Let search engines index public pages. Off by default (noindex meta and robots.txt).
SITE_INDEXING=False
# Admin 2FA (TOTP). Off by default. Enrol every staff user first (docs/deploy.md, "Enabling 2FA
# later"), then set True and run `dc up -d`.
ADMIN_REQUIRE_2FA=False
# The club Google Sheet for the admin's sheet sync (docs/deploy.md, "Sheet sync"). Empty turns it
# off. The ID is the access link: it lives only here, never in the repository.
GOOGLE_SHEET_ID=

# --- Database ---
# URL-safe characters only (it goes into DATABASE_URL): python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=replace-with-a-random-value

# --- Backups (deploy/backup.sh) ---
# Public key from `age-keygen` on your own machine. The private key never goes to the server.
AGE_RECIPIENT=age1replace-with-your-public-key
# Backblaze B2 bucket and a bucket-scoped "Write Only" application key (no delete rights).
B2_BUCKET=replace-with-bucket-name
B2_KEY_ID=replace-with-key-id
B2_APPLICATION_KEY=replace-with-application-key
# healthchecks.io ping URL of the nightly backup check (period 1 day, grace 2 hours).
HEALTHCHECKS_BACKUP_URL=https://hc-ping.com/replace-with-uuid

# --- Optional: site uptime check (deploy/sitecheck.sh) ---
# Leave empty to disable. healthchecks.io check with period 5 minutes, grace 10 minutes.
HEALTHCHECKS_SITE_URL=
