# Dummy values for local development. Copy to .env and adjust. The server uses .env.prod.example.
# ENVIRONMENT=production turns on strict validation and HTTPS settings, and forces DEBUG off.
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-me-to-a-long-random-value-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/traktorist_club
# Admin prefix. Production refuses the default "admin/".
ADMIN_URL=club-admin/
# Let search engines index public pages (noindex meta and robots.txt otherwise).
SITE_INDEXING=False
# Ask for a TOTP code at admin login (off by default everywhere). Enrol first: manage.py totp_enroll <user>
ADMIN_REQUIRE_2FA=False
# The club Google Sheet for the admin's sheet sync (shared "anyone with the link can view").
# Empty turns the sync off. The ID is the access link: never commit a real one.
GOOGLE_SHEET_ID=

# Production only (optional). HSTS preload is always off.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
