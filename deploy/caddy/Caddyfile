# HTTPS front for the app. Caddy gets and renews the Let's Encrypt certificate (HTTP-01 on port 80)
# on its own; no email is configured, since Let's Encrypt no longer sends expiry notices.
#
# Django sets CSP, HSTS, X-Frame-Options, nosniff, Referrer-Policy and COOP on its own responses;
# the "?" lines give static files the same (a "?" header is only added where none is set, so
# Django's values win). Permissions-Policy comes from Caddy alone, for every response.

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		?Strict-Transport-Security "max-age=31536000"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "same-origin"
		?X-Frame-Options "DENY"
		?Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# Collected static files (copied into the shared volume by the web container). Names with a
	# ManifestStaticFilesStorage hash never change content, so browsers may keep them for a year.
	handle_path /static/* {
		root * /srv/static
		@hashed path_regexp \.[0-9a-f]{12}\.[A-Za-z0-9]+$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "public, max-age=3600"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
