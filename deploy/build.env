# Placeholders for the image build stage (Dockerfile, "assets"): they only satisfy the production
# settings validation so tailwind build, compilemessages and collectstatic can import the settings.
# Nothing is signed, stored or connected to at build time, and none of this reaches the runtime
# image. Real values live in the server's .env (see .env.prod.example).
ENVIRONMENT=production
SECRET_KEY=build-stage-placeholder-used-only-to-import-settings-0123456789
ALLOWED_HOSTS=build.invalid
DATABASE_URL=postgresql://build:build@build.invalid:5432/build
ADMIN_URL=build-only/
