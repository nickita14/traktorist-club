# Russian strings for django-unfold, which ships no translations of its own.
#
# Hand-maintained. Do not run makemessages on this file: the project has no translatable strings
# of its own (the UI is written in Russian), so makemessages would mark every entry obsolete.
# Only strings Django's own catalog lacks belong here; the build compiles this file into
# django.mo (gitignored) with compilemessages.
msgid ""
msgstr ""
"Project-Id-Version: traktorist-club\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=4; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && "
"(n%100<12 || n%100>14) ? 1 : n%10==0 || (n%10>=5 && n%10<=9) || (n%100>=11 && "
"n%100<=14)? 2 : 3);\n"

